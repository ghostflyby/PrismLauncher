<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Native AOT is a hard requirement for the Flint core (docs/PLAN.md). -->
    <PublishAot>true</PublishAot>
    <!-- Force source-generated JSON only; catch accidental reflection usage at build time. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlintLauncher.Core\FlintLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise FlintJsonContext's source-generated roots directly (the AOT
         smoke: a root type missing from the context is a RUNTIME failure, not a compile
         error) — same pattern as Core's InternalsVisibleTo. -->
    <InternalsVisibleTo Include="FlintLauncher.Tests" />
  </ItemGroup>

</Project>
