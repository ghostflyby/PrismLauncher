<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Keep the domain core AOT/trimming clean; enforced by analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The LibraryImport source generator emits pointer code for the libc/kernel32 P/Invoke
         stubs (FileTransfer, HardwareInfo), so unsafe must be allowed project-wide. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlintLauncher.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Worlds layer (Minecraft/Worlds) is built on the standalone NBT library. -->
    <ProjectReference Include="..\FlintLauncher.Nbt\FlintLauncher.Nbt.csproj"/>
    <!-- The third-party API wire layer (models + source-gen contexts) is a leaf assembly. -->
    <ProjectReference Include="..\FlintLauncher.ExternalApi\FlintLauncher.ExternalApi.csproj"/>
  </ItemGroup>


  <!--
    Build the Java launcher jars (NewLaunch/NewLaunchLegacy) directly with javac/jar
    (mirroring libraries/launcher CMakeLists) and embed them into the assembly. Incremental
    via Inputs/Outputs per jar; FlintSkipJarBuild=true bypasses. EmbeddedResource items are
    declared INSIDE the target: a static declaration made CSC read the jars before this
    target ran on clean trees (CS1566) — the in-target ItemGroup is the standard
    generate-and-embed fix. (JavaCheck.jar died with the JdkFind probe migration.)
  -->
  <PropertyGroup>
    <JarOutputDir>$(MSBuildThisFileDirectory)../build/jars/</JarOutputDir>
    <LauncherSourceDir>$(MSBuildThisFileDirectory)../libraries/launcher</LauncherSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- NewLaunch.jar sources: org/prismlauncher EXCEPT legacy/, plus legacy/LegacyProxy.java
         (both in the upstream CMake SRC list). -->
    <NewLaunchSource Include="$(LauncherSourceDir)/org/prismlauncher/**/*.java"/>
    <NewLaunchSource Remove="$(LauncherSourceDir)/org/prismlauncher/legacy/**/*.java"/>
    <NewLaunchSource Include="$(LauncherSourceDir)/org/prismlauncher/legacy/LegacyProxy.java"/>
    <NewLaunchLegacySource Include="$(LauncherSourceDir)/legacy/**/*.java"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14"/>
    <!-- The Options read face of the typed user layer (IOptionsMonitor over the flint.json
         store). No configuration binder is involved: the store hands its record through. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14"/>
    <!-- JVM enumeration (Apache-2.0, GPL-3.0-compatible): the provider suite backs the
         first discovery layer in JavaUtils.FindJavaPaths. -->
    <PackageReference Include="JdkFind" Version="0.8.0"/>
    <!-- TOML parsing (BSD-2-Clause, GPL-3.0-compatible, AOT-safe): typed source-generated
         DTOs replace the hand-rolled packwiz subset parser. -->
    <PackageReference Include="Tomlyn" Version="2.10.2"/>
    <PackageReference Include="TruePath" Version="2.0.0"/>
    <PackageReference Include="TruePath.SystemIo" Version="2.0.0"/>
  </ItemGroup>

  <Target Name="NewLaunchJar" Inputs="@(NewLaunchSource)" Outputs="$(JarOutputDir)NewLaunch.jar" Condition="'$(FlintSkipJarBuild)' != 'true'">
    <MakeDir Directories="$(JarOutputDir)classes/newlaunch"/>
    <Exec Command="javac --release 8 -d &quot;$(JarOutputDir)classes/newlaunch&quot; @(NewLaunchSource->'&quot;%(FullPath)&quot;', ' ')"/>
    <Exec Command="jar --create --file &quot;$(JarOutputDir)NewLaunch.jar&quot; --main-class org.prismlauncher.EntryPoint -C &quot;$(JarOutputDir)classes/newlaunch&quot; ."/>
  </Target>

  <!-- UseJava INCLUDE_JARS(NewLaunch): legacy compiles against NewLaunch.jar, manifest
       carries the matching Class-Path. -->
  <Target Name="NewLaunchLegacyJar" DependsOnTargets="NewLaunchJar" Inputs="@(NewLaunchLegacySource);$(JarOutputDir)NewLaunch.jar" Outputs="$(JarOutputDir)NewLaunchLegacy.jar" Condition="'$(FlintSkipJarBuild)' != 'true'">
    <MakeDir Directories="$(JarOutputDir)classes/legacy"/>
    <WriteLinesToFile File="$(JarOutputDir)classes/legacy.mf" Lines="Class-Path: NewLaunch.jar" Overwrite="true"/>
    <Exec Command="javac --release 8 -cp &quot;$(JarOutputDir)NewLaunch.jar&quot; -d &quot;$(JarOutputDir)classes/legacy&quot; @(NewLaunchLegacySource->'&quot;%(FullPath)&quot;', ' ')"/>
    <Exec Command="jar --create --file &quot;$(JarOutputDir)NewLaunchLegacy.jar&quot; --main-class org.prismlauncher.EntryPoint --manifest &quot;$(JarOutputDir)classes/legacy.mf&quot; -C &quot;$(JarOutputDir)classes/legacy&quot; ."/>
  </Target>

  <!-- EmbeddedResource items are created INSIDE the target (generate-and-embed pattern):
       a static declaration made CSC read the jars before this target ran on clean trees. -->
  <Target Name="BuildJavaJars" DependsOnTargets="NewLaunchJar;NewLaunchLegacyJar" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(JarOutputDir)NewLaunch.jar" Link="jars/NewLaunch.jar" Condition="Exists('$(JarOutputDir)NewLaunch.jar')"/>
      <EmbeddedResource Include="$(JarOutputDir)NewLaunchLegacy.jar" Link="jars/NewLaunchLegacy.jar" Condition="Exists('$(JarOutputDir)NewLaunchLegacy.jar')"/>
    </ItemGroup>
  </Target>
</Project>
