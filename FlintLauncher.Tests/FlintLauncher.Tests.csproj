<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- xunit.v3 test projects are executables: the framework's source generator emits the
         entry point that hosts its Microsoft.Testing.Platform runner, which the .NET 10
         SDK's dotnet test drives natively (enabled by "test.runner" in global.json). The
         VSTest stack (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) is gone with the
         v3 migration — the SDK refuses a project that mixes VSTest with MTP. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 asks every HttpClient call site to thread TestContext.Current.CancellationToken
         through; with 500+ call sites that is churn without payoff for a 40s serial suite that
         only ever runs to completion. Revisit if the suite ever needs interactive cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlintLauncher.Core\FlintLauncher.Core.csproj"/>
    <ProjectReference Include="..\FlintLauncher.Nbt\FlintLauncher.Nbt.csproj"/>
    <!-- API integration tests host FlintLauncher.Web in-process (BuildWebApplication). -->
    <ProjectReference Include="..\FlintLauncher.Web\FlintLauncher.Web.csproj"/>
  </ItemGroup>

  <!-- Fixtures ported from the original C++ tests (tests/testdata). -->
  <ItemGroup>
    <Content Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <!-- Serialize test collections: several suites use process-global state (the API
       integration tests chdir into a temp data dir; others mutate static config hooks). -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
